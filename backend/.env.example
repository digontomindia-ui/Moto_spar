# Coolify production environment (set these in Coolify; do not commit .env).
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ORIGIN_WHITELIST=https://app.example.com
SECURE_SSL_REDIRECT=True

# Product links returned by the chatbot.
PRODUCT_PAGE_URL_TEMPLATE=https://api.example.com/products/{product_id}/

# Required by the chatbot catalog endpoints. Generate a long random value and set
# the same value as an X-API-Key header in n8n. Never expose it in browser code.
CHATBOT_API_KEY=replace-with-a-long-random-chatbot-api-key

# Managed PostgreSQL database. Use sslmode=require for the supplied connection.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-managed-database-password
DATABASE_HOST=replace-with-managed-database-host
DATABASE_PORT=5432
DATABASE_SSLMODE=require

# Required integrations (supply real values in Coolify when enabled).
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_REDIRECT_URI=https://api.example.com/auth/google/callback/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
