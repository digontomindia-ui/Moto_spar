# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# API_BASE_URL: Base URL for the MotoSpar backend API (defaults to https://api.motospar.com when unset).
API_BASE_URL="https://api.motospar.com"
VITE_API_BASE_URL="https://api.motospar.com"

# Server-side webhook used by the local browser /chat-proxy. For Android,
# configure N8N_CHAT_WEBHOOK_URL on the deployed Django backend instead.
# Use an active production /webhook/ endpoint, never /webhook-test/.
N8N_CHAT_WEBHOOK_URL=""
# Development-only direct webhook. VITE_* values are embedded in the Android app.
VITE_N8N_CHAT_WEBHOOK_URL=""

# VITE_GOOGLE_CLIENT_ID: Public Google OAuth 2.0 Web Client ID for Google Sign-In token exchange.
VITE_GOOGLE_CLIENT_ID="818269488302-svso0iqe2cfb53d87s99q2b4h4betkj1.apps.googleusercontent.com"
